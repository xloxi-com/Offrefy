{% comment %}
  App block — Product information → Add block → Apps (product templates only).
  Injects storefront JS/CSS + widget markup here only. App embed sets the live
  enable flag on product pages; design mode sets the flag so theme editor works
  when body embeds are not injected.
{% endcomment %}
{% liquid
  assign vd_is_product_page = false
  if request.page_type == 'product' or template.name == 'product'
    assign vd_is_product_page = true
  endif

  if closest.product != blank
    assign vd_product = closest.product
  elsif product != blank
    assign vd_product = product
  endif
%}
{% if vd_is_product_page or request.design_mode %}
  {% if request.design_mode %}
    <script>
      (function () {
        var o = window.Offrefy;
        if (!o || typeof o !== "object") {
          o = {};
          try {
            Object.defineProperty(window, "Offrefy", {
              value: o,
              writable: true,
              configurable: true,
              enumerable: false,
            });
          } catch (e) {
            window.Offrefy = o;
          }
        }
        o.appEmbedActive = true;
      })();
    </script>
  {% endif %}
  {% render 'vd-storefront-assets', vd_product: vd_product %}
  {% render 'vd-quantity-breaks', block: block, vd_product: vd_product %}
{% endif %}

{% schema %}
{
  "name": "t:volume_discount.blocks.quantity_breaks.name",
  "target": "section",
  "stylesheet": "volume-discount-storefront.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
