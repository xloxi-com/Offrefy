{% comment %}
  App block — Theme editor → Add section → Apps, or Product information → Add block → Apps.
  Available on all templates (not product-only) so reviewers/merchants find it from Home too.
  Product comes from closest.product or the template product (no theme-editor settings).
  Boots storefront JS/CSS here so the widget still mounts when the app embed is on
  but Hyper/theme-editor preview does not inject body embeds reliably. Embed remains
  the recommended global path (cart badge etc. on non-product pages).
{% endcomment %}
{% liquid
  if closest.product != blank
    assign vd_product = closest.product
  elsif product != blank
    assign vd_product = product
  endif
%}
<script>window.__vdAppEmbedActive = true;</script>
{% render 'vd-storefront-assets', vd_product: vd_product %}
{% render 'vd-quantity-breaks', block: block, vd_product: vd_product %}

{% schema %}
{
  "name": "t:volume_discount.blocks.quantity_breaks.name",
  "target": "section",
  "stylesheet": "volume-discount-storefront.css",
  "settings": []
}
{% endschema %}
