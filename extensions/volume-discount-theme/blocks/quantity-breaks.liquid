{% comment %}
  Section app block — appears in Product information → Add block → Apps.
{% endcomment %}
{% render 'vd-quantity-breaks', block: block %}

{% schema %}
{
  "name": "t:volume_discount.blocks.quantity_breaks.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.quantity_breaks.paragraph"
    },
    {
      "type": "checkbox",
      "id": "show_section_heading",
      "label": "t:volume_discount.settings.show_section_heading",
      "info": "t:volume_discount.settings.show_section_heading_info",
      "default": false
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "t:volume_discount.settings.section_heading",
      "default": "Offers",
      "info": "t:volume_discount.settings.section_heading_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:volume_discount.settings.heading",
      "default": "Get more, save more 🥳",
      "info": "t:volume_discount.settings.heading_info"
    }
  ]
}
{% endschema %}
