{% comment %}
  App embed (body) — Theme settings → App embeds.
  Loads storefront JS/CSS. On product pages also mounts a fallback Quantity breaks
  widget (moved near Add to cart). If a section “Quantity breaks” block is present,
  that block wins and the fallback is removed by storefront JS.
{% endcomment %}
{% liquid
  if product != blank
    assign vd_product = product
  elsif closest.product != blank
    assign vd_product = closest.product
  endif
%}
<script>window.__vdAppEmbedActive = true;</script>
{% render 'vd-storefront-assets', vd_product: vd_product %}
{% if vd_product != blank %}
  {% comment %}
    Product-page fallback widget when the merchant has not added the Quantity breaks
    section block. Section blocks still take priority (JS removes this fallback).
  {% endcomment %}
  {% render 'vd-quantity-breaks', vd_product: vd_product, vd_from_embed: true %}
{% endif %}

{% schema %}
{
  "name": "t:volume_discount.blocks.embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.embed.paragraph"
    }
  ]
}
{% endschema %}
