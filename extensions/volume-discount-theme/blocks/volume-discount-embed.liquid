{% comment %}
  App embed (body) — Theme settings → App embeds.
  Required to load storefront JS/CSS. The quantity widget renders only where the
  merchant adds the “Quantity breaks” app block / section — never auto-injected here.
  When this embed is off, product-page widgets must not appear.
{% endcomment %}
{% liquid
  if product != blank
    assign vd_product = product
  elsif closest.product != blank
    assign vd_product = closest.product
  endif
%}
<script>window.__vdAppEmbedActive = true;</script>
{% render 'vd-storefront-assets', vd_product: vd_product %}

{% schema %}
{
  "name": "t:volume_discount.blocks.embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.embed.paragraph"
    }
  ]
}
{% endschema %}
