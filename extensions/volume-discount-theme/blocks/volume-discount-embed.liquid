{% comment %}
  App embed (body) — Theme settings → App embeds.
  Enable flag on product pages only. No CSS/JS here (avoids collection/home
  inject). Storefront assets load from the Quantity breaks app block.
{% endcomment %}
{% if request.page_type == 'product' or template.name == 'product' %}
  <script>window.__xloxiAppEmbedActive = true;</script>
{% endif %}

{% schema %}
{
  "name": "t:volume_discount.blocks.embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.embed.paragraph"
    }
  ]
}
{% endschema %}
