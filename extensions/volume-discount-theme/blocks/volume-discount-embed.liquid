{% comment %}
  App embed (body) — Theme settings → App embeds.
  Enable flag only. Storefront JS/CSS inject where the merchant added the
  “Quantity breaks” app block (product page / section), not on every page.
{% endcomment %}
<script>window.__vdAppEmbedActive = true;</script>

{% schema %}
{
  "name": "t:volume_discount.blocks.embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.embed.paragraph"
    }
  ]
}
{% endschema %}
