{% comment %}
  App embed (head) — Theme settings → App embeds → Offrefy (global).
  Runs in <head> on product pages so Theme product form hide CSS applies
  before price / variants / ATC paint (no flash on refresh).
{% endcomment %}
{% liquid
  assign vd_is_product_page = false
  if request.page_type == 'product' or template.name == 'product'
    assign vd_is_product_page = true
  endif

  if product != blank
    assign vd_product = product
  elsif closest.product != blank
    assign vd_product = closest.product
  endif
%}
{% if vd_is_product_page %}
  <script>
    (function () {
      var o = window.Offrefy;
      if (!o || typeof o !== "object") {
        o = {};
        try {
          Object.defineProperty(window, "Offrefy", {
            value: o,
            writable: true,
            configurable: true,
            enumerable: false,
          });
        } catch (e) {
          window.Offrefy = o;
        }
      }
      o.appEmbedActive = true;
    })();
  </script>
  {% render 'vd-hide-theme-atc', vd_product: vd_product %}
{% endif %}

{% schema %}
{
  "name": "t:volume_discount.blocks.embed.name",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:volume_discount.blocks.embed.paragraph"
    }
  ]
}
{% endschema %}
