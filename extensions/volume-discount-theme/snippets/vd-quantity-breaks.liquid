{% liquid
  assign vd_widget = shop.metafields.volume_discount.storefront_widget.value
  assign demo_json = '{"version":1,"campaigns":[{"id":"_preview","campaignName":"Preview","displayName":null,"productScope":"all","quantityCondition":"per-variant","customerType":"everyone","customerTags":[],"productIds":[],"countdownStartsAt":null,"countdownEndsAt":"2099-12-31T23:59:59.999Z","tiers":[{"minQty":1,"buyLabel":"Buy 1","badge":"Most Popular ⚡","activeByDefault":true,"percent":0},{"minQty":2,"buyLabel":"Buy 2+","badge":null,"activeByDefault":false,"percent":10},{"minQty":4,"buyLabel":"Buy 4+","badge":null,"activeByDefault":false,"percent":15}],"widgetDisplay":{"widgetHeading":"","showCountdown":true,"countdownLabel":"Sale end in","ctaLabel":"Grab this deal","footnote":"Pick a tier to set quantity, then add to cart.","primaryColor":"#6b1d1e","primaryHoverColor":"#551618","selectedBgColor":"#fff5f5","countdownBgColor":"#fce8e8","countdownTextColor":"#b42318","savingsColor":"#784a4f","optionSubtextColor":"#784a4f","mutedColor":"#616161","cardBorderColor":"#d4d4d4","fontScale":"default","fontSizeScalePercent":100,"fontSizeTitle":19,"fontSizeBuyLabel":16,"fontSizeBadge":12,"fontSizePrice":17,"fontSizeComparePrice":13,"fontSizeSavings":12,"fontSizeButton":17,"fontSizeCountdownLabel":13,"fontSizeCountdownValue":13,"fontSizeFootnote":12,"ctaButtonAction":"add_to_cart_open_drawer","ctaButtonPageUrl":"","hideThemeAddToCart":false}}]}'

  if vd_product == blank and closest.product != blank
    assign vd_product = closest.product
  endif
  if vd_product == blank and product != blank
    assign vd_product = product
  endif

  # No theme-editor heading setting; app widgetHeading controls the title.
  # Soft-read legacy block.settings.heading only if previously saved.
  if block and block.settings.heading != blank
    assign vd_heading = block.settings.heading
  else
    assign vd_heading = ''
  endif
  if block and block.settings.show_section_heading == true and block.settings.section_heading != blank
    assign vd_section_heading = block.settings.section_heading | strip
  else
    assign vd_section_heading = ''
  endif
  assign vd_id_suffix = block.id | default: 'quantity-breaks'

  assign locale_base = request.locale.iso_code | split: '-' | first | downcase
  assign vd_trans_buy = 'Buy'
  assign vd_trans_you_save = 'You save'
  assign vd_trans_add = 'Add'

  if vd_widget and vd_widget.translations
    assign locale_trans = vd_widget.translations[locale_base]
    if locale_trans
      if locale_trans.transBuy != blank
        assign vd_trans_buy = locale_trans.transBuy
      endif
      if locale_trans.transYouSave != blank
        assign vd_trans_you_save = locale_trans.transYouSave
      endif
      if locale_trans.transAdd != blank
        assign vd_trans_add = locale_trans.transAdd
      endif
    endif
  endif
%}
{%- comment -%}
  Markup only. Storefront JS/CSS inject from the Quantity breaks app block
  (quantity-breaks.liquid), not the global app embed.

  Liquid product form (offrefy-atc-form-*) is the cross-theme ATC bridge:
  Shopify {% form 'product' %} works on every free/premium theme. Widget JS
  syncs qty/variant here and either clicks the theme ATC or submits this form
  via /cart/add.js so drawers/notifications still work.
{%- endcomment -%}
{%- liquid
  assign vd_product_form_id = 'offrefy-atc-form-' | append: vd_id_suffix
  assign vd_early_paint = false
  if request.design_mode
    assign vd_early_paint = true
  elsif vd_product != blank and vd_product.metafields.volume_discount.tiers.value
    assign vd_early_paint = true
  elsif vd_widget != blank and vd_widget.campaigns.size > 0
    assign vd_early_paint = true
  endif
-%}
<div
  class="offrefy-root offrefy-qb{% if vd_early_paint %} offrefy-root--early{% endif %}"
  id="offrefy-shopify-{{ vd_id_suffix }}"
  data-offrefy-root
  data-offrefy-widget-host
  data-config-id="offrefy-json-{{ vd_id_suffix }}"
  data-storefront-locale="{{ request.locale.iso_code }}"
  data-offrefy-trans-buy="{{ vd_trans_buy | escape }}"
  data-offrefy-trans-you-save="{{ vd_trans_you_save | escape }}"
  data-offrefy-trans-add="{{ vd_trans_add | escape }}"
  data-heading="{{ vd_heading | escape }}"
  data-section-heading="{{ vd_section_heading | escape }}"
  data-offrefy-product-form-id="{{ vd_product_form_id }}"
  data-offrefy-use-liquid-form="1"
  data-offrefy-cart-drawer-section="cart-drawer"
  {% if vd_early_paint %}data-offrefy-early="1"{% endif %}
  {% if vd_product != blank %}
    data-product-id="{{ vd_product.id }}"
    data-variant-id="{{ vd_product.selected_or_first_available_variant.id }}"
    data-product-title="{{ vd_product.title | escape }}"
    {% if vd_product.featured_image %}
      data-product-image="{{ vd_product.featured_image | image_url: width: 240 | escape }}"
    {% elsif vd_product.featured_media and vd_product.featured_media.preview_image %}
      data-product-image="{{ vd_product.featured_media.preview_image | image_url: width: 240 | escape }}"
    {% endif %}
    {% if vd_product.admin_graphql_api_id != blank %}
      data-product-gid="{{ vd_product.admin_graphql_api_id | escape }}"
    {% endif %}
    {% if vd_product.selected_or_first_available_variant.admin_graphql_api_id != blank %}
      data-variant-gid="{{ vd_product.selected_or_first_available_variant.admin_graphql_api_id | escape }}"
    {% endif %}
    data-unit-price-cents="{{ vd_product.selected_or_first_available_variant.price }}"
    data-currency="{% if cart.currency.iso_code %}{{ cart.currency.iso_code }}{% elsif shop.currency.iso_code %}{{ shop.currency.iso_code }}{% else %}USD{% endif %}"
    data-collection-gids="{% if vd_product.collections.size > 0 %}[{% for col in vd_product.collections %}{{ col.admin_graphql_api_id | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% else %}[]{% endif %}"
  {% elsif request.design_mode %}
    data-product-id="0"
    data-variant-id="0"
    data-product-title="Sample product"
    data-unit-price-cents="2500"
    data-currency="{% if cart.currency.iso_code %}{{ cart.currency.iso_code }}{% elsif shop.currency.iso_code %}{{ shop.currency.iso_code }}{% else %}USD{% endif %}"
  {% endif %}
  {% if request.design_mode %}
    data-design-mode="true"
  {% elsif vd_early_paint == false %}
    {%- comment -%}
      No shop/product offer signal: hide until JS confirms (avoids empty CLS).
      When offers exist, paint immediately (skeleton → real widget, no refresh delay).
    {%- endcomment -%}
    hidden
    style="display:none;margin:0;padding:0;min-height:0;"
  {% endif %}
>
  {% if vd_product != blank %}
    <script type="application/json" data-offrefy-options-json>
      {{ vd_product.options | json }}
    </script>
    <script type="application/json" data-offrefy-variants-json>
      [
        {%- for v in vd_product.variants -%}
          {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{% if v.available %}true{% else %}false{% endif %},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | json }},"option3":{{ v.option3 | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
    {% if vd_product.metafields.volume_discount.tiers.value %}
      <script type="application/json" data-offrefy-product-rule>
        {{ vd_product.metafields.volume_discount.tiers.value | json }}
      </script>
    {% endif %}
  {% endif %}
  <script type="application/json" id="offrefy-json-{{ vd_id_suffix }}">
    {% if request.design_mode %}
      {% if vd_widget != blank and vd_widget.campaigns.size > 0 %}
        {{ vd_widget | json }}
      {% else %}
        {{ demo_json }}
      {% endif %}
    {% elsif vd_widget == blank %}
      {"version":1,"campaigns":[]}
    {% else %}
      {{ vd_widget | json }}
    {% endif %}
  </script>
  {%- comment -%}
    Keep mount visible in the theme editor so Shopify does not mark the app block
    as "hidden" (red eye icon). Live storefront starts hidden until JS mounts tiers.

    Liquid {% form 'product' %} is the universal Add to cart path on every theme:
    theme JS intercepts submit → /cart/add.js → cart drawer / notification update.
    BOGO "Add N + unlock offer" is type=submit form="{{ vd_product_form_id }}"
    so it uses this same form — no custom cart API.

    Do NOT set name="id"/name="quantity" in HTML — themes querySelector those
    and would bind qty +/- to this hidden field. JS arms names only on submit.
  {%- endcomment -%}
  {% if vd_product != blank %}
    {% form 'product', vd_product, id: vd_product_form_id, class: 'offrefy-liquid-product-form', data-offrefy-liquid-product-form: '1' %}
      <input
        type="hidden"
        value="{{ vd_product.selected_or_first_available_variant.id }}"
        data-offrefy-liquid-variant-id
      >
      <input
        type="hidden"
        value="1"
        min="1"
        data-offrefy-liquid-qty
      >
      <button
        type="submit"
        class="offrefy-liquid-submit"
        hidden
        tabindex="-1"
        aria-hidden="true"
        data-offrefy-liquid-submit
        data-offrefy-action="liquid-submit"
        style="display:none!important;visibility:hidden!important;position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;"
      >
        {{ vd_trans_add | escape }}
      </button>
    {% endform %}
  {% endif %}
  <div
    class="offrefy-qb__inner offrefy-mount"
    data-offrefy-mount
    {% unless vd_early_paint or request.design_mode %}hidden{% endunless %}
  >{% if vd_early_paint %}<div class="offrefy-vd-skel" data-offrefy-vd-skel aria-busy="true" aria-hidden="true"><span class="offrefy-vd-skel__bar"></span><span class="offrefy-vd-skel__card"></span><span class="offrefy-vd-skel__card"></span><span class="offrefy-vd-skel__card"></span><span class="offrefy-vd-skel__cta"></span></div>{% endif %}</div>
  {% if vd_early_paint %}
  <script>
    (function () {
      var root = document.getElementById({{ 'offrefy-shopify-' | append: vd_id_suffix | json }});
      if (!root) return;
      root.removeAttribute("hidden");
      root.hidden = false;
      root.style.display = "";
      root.style.removeProperty("margin");
      root.style.removeProperty("padding");
      root.style.removeProperty("min-height");
      var mount = root.querySelector("[data-offrefy-mount]");
      if (mount) mount.hidden = false;
    })();
  </script>
  {% endif %}
</div>
