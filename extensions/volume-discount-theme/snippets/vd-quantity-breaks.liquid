{% liquid
  assign vd_widget = shop.metafields.volume_discount.storefront_widget.value
  assign demo_json = '{"version":1,"campaigns":[{"id":"_preview","campaignName":"Preview","displayName":null,"productScope":"all","quantityCondition":"per-variant","customerType":"everyone","customerTags":[],"productIds":[],"countdownStartsAt":null,"countdownEndsAt":"2099-12-31T23:59:59.999Z","tiers":[{"minQty":1,"buyLabel":"Buy 1","badge":"Most Popular ⚡","activeByDefault":true,"percent":0},{"minQty":2,"buyLabel":"Buy 2+","badge":null,"activeByDefault":false,"percent":10},{"minQty":4,"buyLabel":"Buy 4+","badge":null,"activeByDefault":false,"percent":15}],"widgetDisplay":{"widgetHeading":"","showCountdown":true,"countdownLabel":"Sale end in","ctaLabel":"Grab this deal","footnote":"Pick a tier to set quantity, then add to cart.","primaryColor":"#6b1d1e","primaryHoverColor":"#551618","selectedBgColor":"#fff5f5","countdownBgColor":"#fce8e8","countdownTextColor":"#b42318","savingsColor":"#784a4f","optionSubtextColor":"#784a4f","mutedColor":"#616161","cardBorderColor":"#d4d4d4","fontScale":"default","fontSizeScalePercent":100,"fontSizeTitle":19,"fontSizeBuyLabel":16,"fontSizeBadge":12,"fontSizePrice":17,"fontSizeComparePrice":13,"fontSizeSavings":12,"fontSizeButton":17,"fontSizeCountdownLabel":13,"fontSizeCountdownValue":13,"fontSizeFootnote":12,"ctaButtonAction":"add_to_cart_open_drawer","ctaButtonPageUrl":"","hideThemeAddToCart":false}}]}'
  if vd_from_embed
    assign vd_heading = 'Get more, save more 🥳'
    assign vd_section_heading = ''
    assign vd_id_suffix = 'app-embed'
  else
    assign vd_heading = block.settings.heading | default: 'Get more, save more 🥳'
    if block.settings.show_section_heading == true
      assign vd_section_heading = block.settings.section_heading | strip
    else
      assign vd_section_heading = ''
    endif
    assign vd_id_suffix = block.id
  endif
%}
{% render 'vd-storefront-assets' %}
<div
  class="vd-storefront-root volume-discount-embed"
  id="vd-shopify-{{ vd_id_suffix }}"
  data-config-id="vd-json-{{ vd_id_suffix }}"
  {% if vd_from_embed %}
    data-vd-embed-fallback="true"
  {% endif %}
  data-heading="{{ vd_heading | escape }}"
  data-section-heading="{{ vd_section_heading | escape }}"
  {% if product %}
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    {% if product.admin_graphql_api_id != blank %}
      data-product-gid="{{ product.admin_graphql_api_id | escape }}"
    {% endif %}
    {% if product.selected_or_first_available_variant.admin_graphql_api_id != blank %}
      data-variant-gid="{{ product.selected_or_first_available_variant.admin_graphql_api_id | escape }}"
    {% endif %}
    data-unit-price-cents="{{ product.selected_or_first_available_variant.price }}"
    data-currency="{% if cart.currency.iso_code %}{{ cart.currency.iso_code }}{% elsif shop.currency.iso_code %}{{ shop.currency.iso_code }}{% else %}USD{% endif %}"
  {% endif %}
  {% if request.design_mode %}
    data-design-mode="true"
  {% endif %}
>
  {% if product %}
    <script type="application/json" data-vd-variants-json>
      [
        {%- for v in product.variants -%}
          {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{% if v.available %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {% endif %}
  <script type="application/json" id="vd-json-{{ vd_id_suffix }}">
    {% if vd_widget == blank %}
      {% if request.design_mode %}
        {{ demo_json }}
      {% else %}
        {"version":1,"campaigns":[]}
      {% endif %}
    {% else %}
      {{ vd_widget | json }}
    {% endif %}
  </script>
  <div class="volume-discount-embed__inner vd-mount" data-vd-mount hidden></div>
</div>
