{% comment %}
  Injected once per page. Section block + body embed both render this snippet; Liquid `render` isolates
  scope so `increment` is not reliable for deduping. Dedupe by whether the bundle script is already in
  the document so we never skip injection when a stale window flag survives a soft navigation.
{% endcomment %}
{% liquid
  assign vd_widget = shop.metafields.volume_discount.storefront_widget.value
  assign locale_base = request.locale.iso_code | split: '-' | first | downcase
  assign vd_cart_discount = '{{ discount }} OFF'
  assign vd_cart_discount_qty = '(qty {{ qty }})'
  assign vd_is_product = false
  if request.page_type == 'product' or template.name == 'product'
    assign vd_is_product = true
  endif

  if vd_widget and vd_widget.translations and vd_widget.translations[locale_base]
    assign locale_trans = vd_widget.translations[locale_base]
    if locale_trans.transCartDiscount != blank
      assign vd_cart_discount = locale_trans.transCartDiscount
    elsif locale_trans.transDiscount != blank
      assign vd_cart_discount = '{{ discount }} ' | append: locale_trans.transDiscount
    endif
    if locale_trans.transCartDiscountQty != blank
      assign vd_cart_discount_qty = locale_trans.transCartDiscountQty
    elsif locale_trans.transQty != blank
      assign vd_cart_discount_qty = '(' | append: locale_trans.transQty | append: ' {{ qty }})'
    endif
  endif
%}
<script>
(function () {
  var VD_ASSET_VERSION = "1.24.1";
  var APP_ORIGIN = "https://offrey.xloxi.com";
  window.__vdStorefrontLocale = {{ request.locale.iso_code | json }};
  window.__vdAssetVersion = VD_ASSET_VERSION;
  window.__vdAppOrigin = APP_ORIGIN;
  {% if vd_widget and vd_widget.rev %}
  window.__vdConfigRev = {{ vd_widget.rev | json }};
  {% else %}
  window.__vdConfigRev = "";
  {% endif %}
  window.__vdCartBadgeTemplates = {
    locale: {{ locale_base | json }},
    discount: {{ vd_cart_discount | json }},
    qty: {{ vd_cart_discount_qty | json }}
  };
  {% if vd_widget and vd_widget.translations %}
  window.__vdStorefrontTranslations = {{ vd_widget.translations | json }};
  {% endif %}

  {% if vd_is_product and product %}
  /* Prefetch via same-origin app proxy first (CSP-safe), then app host CORS fallback. */
  (function prefetchVdConfig() {
    var shop = {{ shop.permanent_domain | json }};
    var pid = {{ product.id | json }};
    var vid = {{ product.selected_or_first_available_variant.id | json }};
    if (!shop || !pid) return;
    var rev = window.__vdConfigRev ? String(window.__vdConfigRev) : "";
    var key = rev + "|" + String(pid) + "|" + String(vid || "");
    window.__vdConfigPrefetchKey = key;
    var q =
      "?shop=" +
      encodeURIComponent(shop) +
      "&product_id=" +
      encodeURIComponent(String(pid)) +
      (vid ? "&variant_id=" + encodeURIComponent(String(vid)) : "") +
      (rev ? "&rev=" + encodeURIComponent(rev) : "") +
      "&_=" +
      encodeURIComponent(String(Math.floor(Date.now() / 5000)));
    var root = "/";
    try {
      if (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) {
        root = window.Shopify.routes.root;
        if (root.slice(-1) !== "/") root += "/";
      }
    } catch (e) {}
    var candidates = [
      root + "apps/volume-discount/widget-config" + q,
      APP_ORIGIN + "/widget-config" + q
    ];
    function tryFetch(i) {
      if (i >= candidates.length) return Promise.resolve(null);
      return fetch(candidates[i], {
        credentials: "omit",
        cache: "no-store",
        headers: { Accept: "application/json" },
        priority: "high",
      })
        .then(function (r) {
          if (r && r.ok) return r.json();
          return tryFetch(i + 1);
        })
        .catch(function () {
          return tryFetch(i + 1);
        });
    }
    window.__vdConfigPrefetch = tryFetch(0);
  })();
  {% endif %}

  /* Cart locale sync is non-critical — never compete with widget boot. */
  function syncVdCartLocaleAttribute() {
    var loc = window.__vdStorefrontLocale;
    if (!loc && document.documentElement) {
      var lang = document.documentElement.getAttribute("lang");
      if (lang) loc = lang;
    }
    if (!loc) {
      var m = String(location.pathname || "").match(/^\/([a-z]{2}(?:-[a-z]{2})?)(\/|$)/i);
      if (m && m[1]) loc = m[1];
    }
    if (!loc) loc = "en";
    loc = String(loc).toLowerCase().split("-")[0];
    try {
      if (sessionStorage.getItem("vd_locale_attr") === loc) return;
    } catch (e) {}
    var root = "/";
    try {
      if (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) {
        root = window.Shopify.routes.root;
        if (root.slice(-1) !== "/") root += "/";
      }
    } catch (e) {}
    fetch(root + "cart/update.js", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ attributes: { vd_locale: loc } }),
    })
      .then(function () {
        try {
          sessionStorage.setItem("vd_locale_attr", loc);
        } catch (e) {}
      })
      .catch(function () {});
  }
  var deferLocale =
    typeof requestIdleCallback === "function"
      ? function (cb) {
          requestIdleCallback(cb, { timeout: 2500 });
        }
      : function (cb) {
          setTimeout(cb, 1200);
        };
  deferLocale(syncVdCartLocaleAttribute);

  var scriptSrc = {{ 'volume-discount-storefront.js' | asset_url | json }};
  scriptSrc +=
    (scriptSrc.indexOf("?") === -1 ? "?" : "&") +
    "vd=" +
    encodeURIComponent(VD_ASSET_VERSION);

  var existing = document.querySelector('script[src*="volume-discount-storefront.js"]');
  if (existing) {
    if (existing.getAttribute("data-vd-asset-version") === VD_ASSET_VERSION) {
      window.__vdStorefrontAssetsLoaded = true;
      return;
    }
    existing.parentNode && existing.parentNode.removeChild(existing);
  }

  window.__vdStorefrontAssetsLoaded = true;
  var head = document.head || document.getElementsByTagName("head")[0];
  var cssHref = {{ 'volume-discount-storefront.css' | asset_url | json }};
  var css = document.createElement("link");
  css.rel = "stylesheet";
  css.href = cssHref;
  {% if vd_is_product %}
  css.fetchPriority = "high";
  {% endif %}
  head.appendChild(css);

  {% if vd_is_product %}
  var pre = document.createElement("link");
  pre.rel = "preload";
  pre.as = "script";
  pre.href = scriptSrc;
  head.appendChild(pre);
  {% endif %}

  var s = document.createElement("script");
  s.src = scriptSrc;
  s.defer = true;
  {% if vd_is_product %}
  s.fetchPriority = "high";
  {% else %}
  s.fetchPriority = "low";
  {% endif %}
  s.setAttribute("data-vd-asset-version", VD_ASSET_VERSION);
  (document.body || head).appendChild(s);
})();
</script>
