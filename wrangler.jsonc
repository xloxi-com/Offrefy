{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "offrefy",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Transaction-mode pooler :6543 (IPv4). Session mode :5432 hits
			// EMAXCONNSESSION (pool_size 15) under Worker concurrency.
			"id": "d74bcb0f876e4b4681ba76aa2b7d76bb"
		}
	]
}