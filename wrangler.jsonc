{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "offrefy",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Session-mode pooler :5432 (IPv4). Transaction :6543 timed out via
			// Hyperdrive; keep Worker Prisma clients per-request (no shared Pool).
			"id": "d74bcb0f876e4b4681ba76aa2b7d76bb"
		}
	],
	// Support Chat — messages as JSON objects in R2 (not in repo).
	"r2_buckets": [
		{
			"binding": "SUPPORT_CHAT_R2",
			"bucket_name": "offrefy-support-chat"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SUPPORT_CHAT_ROOM",
				"class_name": "SupportChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-support-chat-room",
			"new_classes": ["SupportChatRoom"]
		}
	],
	"vars": {
		"SUPPORT_EMAIL": "info@xloxi.com",
		"SUPPORT_CHAT_REPLY_DOMAIN": "chat-replies.xloxi.com"
	}
}
