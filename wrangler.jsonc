{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "offrefy",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Session-mode pooler :5432 (IPv4). Direct db.*.supabase.co is IPv6-only
			// on free plans — Hyperdrive cannot reach it and admin auth times out.
			"id": "d74bcb0f876e4b4681ba76aa2b7d76bb"
		}
	]
}